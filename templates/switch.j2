! ============================================================
!  Autofig Generated Switch Configuration
! ============================================================

hostname {{ device.hostname }}

!
! ===== VLAN Configuration =====
!
{% if device.vlans %}
{% for vlan in device.vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% endfor %}
{% else %}
! No VLANs defined
{% endif %}

!
! ===== Interface Configuration =====
!
{% if device.interfaces %}
{% for intf in device.interfaces %}
interface {{ intf.name }}
{% if intf.mode == "access" %}
 switchport mode access
 switchport access vlan {{ intf.vlan }}
{% elif intf.mode == "trunk" %}
 switchport mode trunk
{% endif %}
{% if intf.port_security and intf.port_security.enabled %}
 switchport port-security
 switchport port-security maximum {{ intf.port_security.max_mac | default(1) }}
 switchport port-security violation {{ intf.port_security.violation | default('shutdown') }}
{% endif %}

{% if intf.description %}
 description {{ intf.description }}
{% endif %}
 no shutdown
!
{% endfor %}
{% else %}
! No interfaces defined
{% endif %}


!
! ===== Services =====
!
{% if 'ntp' in device.services %}
{% for server in defaults.ntp_servers %}
ntp server {{ server }}
{% endfor %}
{% endif %}

{% if 'ssh' in device.services %}
ip domain-name {{ defaults.domain | default("local") }}
crypto key generate rsa modulus {{ defaults.ssh_rsa_bits | default(2048) }}
line vty 0 4
 transport input ssh
 login local
{% endif %}


!
! ===== Spanning Tree =====
!
{% if device.stp %}
spanning-tree mode {{ device.stp.mode }}
{% endif %}




!
! ===== Banner =====
!
{% if device.security and device.security.banner %}
banner motd @
{{ device.security.banner }}
@
{% endif %}

!
! ===== End =====
!
end
