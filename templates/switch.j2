! ============================================================
!  Autofig Generated Switch Configuration
! ============================================================

hostname {{ device.hostname }}

!
! ===== VLAN Configuration =====
!
{% if device.vlans %}
{% for vlan in device.vlans %}
vlan {{ vlan.id }}
 name {{ vlan.name }}
{% endfor %}
{% endif %}

!
! ===== Interface Configuration =====
!
{% for intf in device.interfaces %}
interface {{ intf.name }}
{% if intf.get('mode') == 'access' %}
 switchport mode access
 switchport access vlan {{ intf.vlan }}
{% elif intf.get('mode') == 'trunk' %}
 switchport mode trunk
{% endif %}
 description {{ intf.description | default("No description") }}
 no shutdown
!
{% endfor %}

!
! ===== Services =====
!
{% if 'ntp' in device.services %}
{% for server in defaults.ntp_servers %}
ntp server {{ server }}
{% endfor %}
{% endif %}

{% if 'ssh' in device.services %}
ip domain-name {{ defaults.domain | default("local") }}
crypto key generate rsa modulus {{ defaults.ssh_rsa_bits | default(2048) }}
line vty 0 4
 transport input ssh
 login local
{% endif %}

!
! ===== Banner =====
!
{% if device.security and device.security.banner %}
banner motd @
{{ device.security.banner }}
@
{% endif %}

!
! ===== End =====
!
end
