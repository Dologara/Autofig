! ============================================================
!  Autofig Generated Router Configuration
! ============================================================

hostname {{ device.hostname }}

!
! ===== Interface Configuration =====
!
{% for intf in device.interfaces %}
interface {{ intf.name }}
  ip address {{ intf.ip }} {{ intf.mask }}
  description {{ intf.description | default("No description") }}
  no shutdown
!
{% endfor %}

!
! ===== Static Routes =====
!
{% if device.routes %}
{% for route in device.routes %}
ip route {{ route.destination }} {{ route.next_hop }}
{% endfor %}
{% else %}
! No static routes defined
{% endif %}
!

!
! ===== OSPF Configuration =====
!
{% if device.ospf %}
router ospf {{ device.ospf.process_id }}
{% for net in device.ospf.networks %}
 network {{ net.network }} {{ net.wildcard }} area {{ net.area }}
{% endfor %}
{% endif %}



! ===== Services =====
!
{% if 'ntp' in device.services %}
{% for server in defaults.ntp_servers %}
ntp server {{ server }}
{% endfor %}
{% endif %}

{% if 'dns' in device.services %}
ip name-server {% for dns in defaults.dns_servers %}{{ dns }} {% endfor %}
{% endif %}

{% if 'ssh' in device.services %}
ip domain-name {{ defaults.domain | default("local") }}
crypto key generate rsa modulus {{ defaults.ssh_rsa_bits | default(2048) }}
line vty 0 4
 transport input ssh
 login local
{% endif %}

!
! ===== DHCP Configuration =====
!
{% if device.dhcp and device.dhcp.pools %}
{% for pool in device.dhcp.pools %}
ip dhcp pool {{ pool.name }}
 network {{ pool.network }} {{ pool.mask }}
 default-router {{ pool.default_router }}
{% if pool.dns %} dns-server {% for d in pool.dns %} {{ d }} {% endfor %}{% endif %}
{% endfor %}
{% endif %}



!
! ===== Banner =====
!
{% if device.security and device.security.banner %}
banner motd @
{{ device.security.banner }}
@
{% endif %}

!
! ===== End =====
!
end
